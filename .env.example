# PostgreSQL settings used by the local Docker Compose stack.
POSTGRES_USER=policy_user
POSTGRES_PASSWORD=policy_dev_password
POSTGRES_DB=policy_db

# Keycloak local administrator bootstrap settings.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_dev_password

# Keycloak realm and JWT audience configured in the Keycloak client.
KEYCLOAK_REALM=policy
KEYCLOAK_AUDIENCE=policy-service

ORCHESTRATOR_POSTGRES_DB=orchestrator_db
LEGACY_POSTGRES_DB=legacy_db
DOCUMENT_INTELLIGENCE_API_KEY=change-me-document-intelligence
COPILOT_RAG_API_KEY=change-me-copilot-rag
